PORT=5000
NODE_ENV=development

# Redis (BullMQ & Idempotency)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# MongoDB (Transaction Ledger & Audit Trail)
MONGO_URI=mongodb://127.0.0.1:27017/razorpay_recovery

# Razorpay API Credentials (Test Mode)
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourKeySecretHere
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere

# Gemini API Key (For Hinglish outreach & PTP agent)
GEMINI_API_KEY=YourGeminiApiKeyHere